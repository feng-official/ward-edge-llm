{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smart-ward/contracts/inference_response.json",
  "title": "CloudInferenceResponse",
  "description": "云端 -> 边缘推理响应消息（MQTT 主题 node/{node_id}/inference/response）。外层信封见 envelope.json；payload 必须包含 event_id、trace_id、judgment、confidence、advice、latency_ms，缺任一字段不得进入成功路径。",
  "type": "object",
  "allOf": [{ "$ref": "envelope.json" }],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["event_id", "trace_id", "judgment", "confidence", "advice", "latency_ms"],
      "properties": {
        "event_id": {
          "type": "string",
          "description": "原请求事件 ID；未知事件/重复响应不污染边缘状态"
        },
        "trace_id": {
          "type": "string",
          "description": "原请求追踪 ID；与 pending 不匹配的响应被拒绝消费"
        },
        "judgment": {
          "type": "string",
          "enum": ["confirm", "reject", "escalate"],
          "description": "云端判断：confirm 确认 / reject 排除 / escalate 升级人工处置；非法值进入失败回退"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "云端判断置信度"
        },
        "advice": {
          "type": "string",
          "description": "护理建议（自然语言）"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "云端处理耗时（毫秒）"
        },
        "model_name": {
          "type": "string",
          "description": "云端模型名称（如 qwen2.5-14b / mock）"
        },
        "model_version": {
          "type": "string",
          "description": "云端模型版本（如 awq-int4 / 0.1.0-mock）"
        }
      },
      "additionalProperties": true
    }
  }
}
